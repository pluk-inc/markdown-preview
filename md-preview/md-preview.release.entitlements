<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(DEVELOPMENT_TEAM).doc.md-preview</string>
    </array>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Security-scoped bookmarks let the project navigator remember a
         folder the reader allowed it to write to (New File, New Folder),
         so it asks once per folder instead of once per launch. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.temporary-exception.apple-events</key>
    <array>
        <string>com.apple.Terminal</string>
    </array>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.print</key>
    <true/>
    <!-- Read-only access to the entire filesystem so the project navigator
         can enumerate sibling folders and resolve relative assets without
         per-folder Powerbox prompts. Same pattern the Quick Look extension
         uses. Writes still go through the sandbox + NSSavePanel. -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
    <array>
        <string>/</string>
    </array>
    <!-- Release only; everything else must match md-preview.entitlements
         (EntitlementsParityTests). Universal Links: Safari and Apple apps
         open md-preview.app/s/ share links in the app (server/share-worker
         serves the matching apple-app-site-association). A restricted
         entitlement: the build must embed a Developer ID provisioning
         profile with Associated Domains, or it does not launch, so
         scripts/release.sh refuses to release without one. Debug builds
         leave it out: doc.md-preview.dev cannot get that profile. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:md-preview.app</string>
    </array>
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
    </array>
</dict>
</plist>
