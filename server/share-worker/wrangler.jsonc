{
  // Share-link API for Markdown Preview (docs/share-link-plan.md §3).
  // `npm run dev` runs it at http://localhost:8787 with a local R2 copy.
  "name": "md-preview-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Production lives on paths of md-preview.app, whose other paths redirect
  // to the website at markdownpreview.app. Cloudflare runs Redirect Rules
  // before Workers, so that rule must skip these paths (README, Deploy).
  "routes": [
    { "pattern": "md-preview.app/s/*", "zone_name": "md-preview.app" },
    { "pattern": "md-preview.app/shares*", "zone_name": "md-preview.app" },
    { "pattern": "md-preview.app/.well-known/apple-app-site-association", "zone_name": "md-preview.app" }
  ],
  "workers_dev": false,
  // The web viewer (viewer/, built into public/ by `npm run build:viewer`).
  // Files under /s/_viewer/ are served as they are; /s/<id> runs the Worker,
  // which answers with the viewer page.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "r2_buckets": [
    { "binding": "SHARES", "bucket_name": "md-preview-shares" }
  ],
  // Per IP. The binding only supports 10 s or 60 s periods.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  // All IPs together may upload this many bytes a UTC day (src/upload-quota.ts).
  // A 30-day link spans at most 31 UTC days, so live links hold at most
  // 155 GB, plus expired ones until the daily purge deletes them.
  "durable_objects": {
    "bindings": [{ "name": "UPLOAD_QUOTA", "class_name": "UploadQuota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UploadQuota"] }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "APPLE_APP_ID": "5P3TSMNV42.doc.md-preview",
    "DAILY_UPLOAD_BYTES": 5000000000
  },
  "observability": { "enabled": true }
}
