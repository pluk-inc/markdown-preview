{
  // Share-link API for Markdown Preview (docs/share-link-plan.md §3).
  // `npm run dev` runs it at http://localhost:8787 with a local R2 copy.
  "name": "md-preview-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [
    { "binding": "SHARES", "bucket_name": "md-preview-shares" }
  ],
  // Per IP. The binding only supports 10 s or 60 s periods.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "APPLE_APP_ID": "5P3TSMNV42.doc.md-preview"
  },
  "observability": { "enabled": true }
}
